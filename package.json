{
  "name": "lld-practice-platform",
  "version": "1.0.0",
  "description": "Low-Level Design (LLD) practice and rubric-based evaluation platform",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev:backend": "tsx watch src/server.ts",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:backend": "tsc",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm run build:backend && npm run build:frontend",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:docs": "node scripts/generate-pdfs.js"
  },
  "keywords": ["lld", "low-level-design", "evaluation-platform", "solid", "design-patterns"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.1",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
